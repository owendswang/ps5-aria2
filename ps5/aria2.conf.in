# PS5 aria2 configuration. Deploy this file as /data/aria2/aria2.conf.
# aria2 creates /data/aria2/downloads when the first download file is opened.
# The CA file below overrides the ELF default /system/common/cert/CA_LIST.cer.

# RPC
enable-rpc=true
rpc-listen-all=true
rpc-listen-port=6800
rpc-secure=false
rpc-allow-origin-all=true
rpc-max-request-size=2M

# PS5 storage and logs
daemon=false
dir=/data/aria2/downloads
continue=true
max-concurrent-downloads=5
max-connection-per-server=5
min-split-size=10M
split=10
max-overall-download-limit=0
max-download-limit=0
max-overall-upload-limit=0
max-upload-limit=0
file-allocation=prealloc
auto-save-interval=60
input-file=/data/aria2/aria2.session
save-session=/data/aria2/aria2.session
save-session-interval=10
show-console-readout=false
console-log-level=notice
dht-file-path=/data/aria2/dht.dat
dht-file-path6=/data/aria2/dht6.dat
log=/data/aria2/aria2.log
log-level=notice

# TLS and DNS
ca-certificate=/data/aria2/ca-bundle.crt
check-certificate=false
disable-ipv6=true
# The PS5 c-ares build cannot discover DNS from the console network settings.
# Keep a reachable DNS server here while async-dns=true.
async-dns=true
async-dns-server=192.168.1.1

# Other option names in this aria2 source release.
# These are commented so upstream defaults remain in effect.
# Uncomment a key and provide a valid value when needed.
# Some platform-only or command-line-only keys may not apply on PS5.

